dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents ../QuoteGenClient-2017/resources.qrc $(DISTDIR)/
	$(COPY_FILE) --parents ../QuoteGenClient-2017/mainwindow.h ../QuoteGenClient-2017/quotedbmanager.h ../QuoteGenClient-2017/quotedbpricemanager.h ../QuoteGenClient-2017/quotepdfmanager.h ../QuoteGenClient-2017/quotepdfmanager.h ../QuoteGenClient-2017/authentication.h ../QuoteGenClient-2017/quotestatus.h ../QuoteGenClient-2017/encryptionhandler.h $(DISTDIR)/
	$(COPY_FILE) --parents ../QuoteGenClient-2017/main.cpp ../QuoteGenClient-2017/mainwindow.cpp ../QuoteGenClient-2017/quotedbmanager.cpp ../QuoteGenClient-2017/quotedbpricemanager.cpp ../QuoteGenClient-2017/quotepdfmanager.cpp ../QuoteGenClient-2017/authentication.cpp ../QuoteGenClient-2017/quotestatus.cpp ../QuoteGenClient-2017/encryptionhandler.cpp $(DISTDIR)/
	$(COPY_FILE) --parents ../QuoteGenClient-2017/mainwindow.ui ../QuoteGenClient-2017/authentication.ui ../QuoteGenClient-2017/quotestatus.ui $(DISTDIR)/


